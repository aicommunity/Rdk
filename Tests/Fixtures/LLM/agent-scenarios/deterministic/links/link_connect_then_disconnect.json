{
  "schema_version": 1,
  "id": "link_connect_then_disconnect",
  "tier": "deterministic",
  "suite": "links",
  "registry_profile": "core",
  "user_text": "соедини и разорви Source1 и Net1",
  "session": {
    "project_loaded": true,
    "llm_write_enabled": true,
    "auto_apply_writes": true
  },
  "env": {
    "NMSDK_LLM_INTENT_LLM": ""
  },
  "mock_script": [
    {
      "tool_calls": [
        {
          "name": "connect_components",
