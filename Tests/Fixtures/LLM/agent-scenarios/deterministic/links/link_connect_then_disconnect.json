          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "disconnect_components",
          "arguments": {
            "from_long_name": "Model.Source1",
            "from_property": "Output",
            "to_long_name": "Model.Net1",
            "to_property": "Input",
            "channel_index": 0
          }
        }
      ]
    },
    {
      "text": "Краткий ответ по результатам tool."
    }
  ],
  "expect": {
    "tools_invoked_all": [
      "connect_components",
      "disconnect_components"
