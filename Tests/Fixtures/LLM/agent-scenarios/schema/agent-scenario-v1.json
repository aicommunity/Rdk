{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent scenario fixture v1",
  "type": "object",
  "required": ["schema_version", "id", "tier", "user_text", "expect"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "tier": { "enum": ["deterministic", "e2e"] },
    "user_text": { "type": "string", "minLength": 1 },
    "suite": { "type": "string" },
    "registry_profile": { "enum": ["core", "full"] },
    "mock_script": { "type": "array" },
    "expect": { "type": "object" },
    "e2e": { "type": "object" }
  },
  "additionalProperties": true
}
