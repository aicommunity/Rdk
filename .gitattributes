# Set LF line endings for all text files
* text=auto eol=lf

# Explicitly specify for C/C++ source files
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.cxx text eol=lf

# CMake files
CMakeLists.txt text eol=lf
*.cmake text eol=lf

# Other text files
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.pro text eol=lf
*.pri text eol=lf
*.ui text eol=lf
*.qrc text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.a binary
*.lib binary
*.vsd binary
